---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - DSC Admin</title>
  </head>
  <body>
    <div class="admin-wrapper">
      <aside class="sidebar">
        <div class="sidebar-header">
          <h2>DSC Admin</h2>
        </div>
        <nav class="sidebar-nav">
          <a href="/admin" class={Astro.url.pathname === '/admin' ? 'active' : ''}>Dashboard</a>
          <a href="/admin/applications" class={Astro.url.pathname.startsWith('/admin/applications') ? 'active' : ''}>Applications</a>
          <a href="/admin/members" class={Astro.url.pathname.startsWith('/admin/members') ? 'active' : ''}>Members</a>
        </nav>
        <div class="sidebar-footer">
          <button id="logout-btn" class="btn btn-secondary btn-sm" style="width: 100%;">Logout</button>
        </div>
      </aside>
      <main class="main-content">
        <slot />
      </main>
    </div>

    <script>
      const logoutBtn = document.getElementById('logout-btn');
      if (logoutBtn) {
        logoutBtn.addEventListener('click', async () => {
          await fetch('/api/admin/logout', { method: 'POST' });
          window.location.href = '/admin/login';
        });
      }
    </script>
  </body>
</html>

<style>
  body {
    margin: 0;
    padding: 0;
    background-color: var(--color-bg);
  }
  .admin-wrapper {
    display: flex;
    min-height: 100vh;
  }
  .sidebar {
    width: 250px;
    background-color: var(--color-bg-alt);
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
  }
  .sidebar-header {
    padding: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }
  .sidebar-header h2 {
    margin: 0;
    font-size: 1.25rem;
    color: var(--color-primary);
  }
  .sidebar-nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: var(--space-4) 0;
  }
  .sidebar-nav a {
    padding: var(--space-3) var(--space-6);
    color: var(--color-text);
    font-weight: 500;
  }
  .sidebar-nav a:hover, .sidebar-nav a.active {
    background-color: #f1f5f9;
    color: var(--color-primary);
    border-left: 4px solid var(--color-primary);
  }
  .sidebar-nav a:not(.active) {
    border-left: 4px solid transparent;
  }
  .sidebar-footer {
    padding: var(--space-4);
    border-top: 1px solid var(--color-border);
  }
  .main-content {
    flex: 1;
    padding: var(--space-8);
    overflow-y: auto;
  }
  .btn {
    padding: var(--space-2) var(--space-4);
    font-weight: 600;
    cursor: pointer;
    border: none;
    border-radius: var(--radius-md);
  }
  .btn-secondary {
    background-color: var(--color-border);
    color: var(--color-text);
  }
</style>
