---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
---

<Layout title="Contact">
  <section class="page-hero section-alt">
    <div class="container">
      <h1>Contact Us</h1>
      <p class="lead">Have questions or want to collaborate? Get in touch with us.</p>
    </div>
  </section>

  <section>
    <div class="container contact-container">
      <div class="grid-2">
        <div class="contact-info">
          <SectionHeading title="Get in Touch" align="left" />
          <p class="contact-desc">Whether you are a student looking to join, or an organization wanting to partner, we'd love to hear from you.</p>
          
          <div class="info-blocks">
            <Card class="info-card">
              <h3>Email</h3>
              <p><a href="mailto:contact@placeholder.edu">contact@placeholder.edu</a></p>
            </Card>
            
            <Card class="info-card">
              <h3>Location</h3>
              <p>Organization / Institution<br/>City, Country Placeholder</p>
            </Card>
            
            <Card class="info-card">
              <h3>Social Media</h3>
              <div class="social-links">
                <a href="#">LinkedIn</a>
                <a href="#">Facebook</a>
                <a href="#">GitHub</a>
              </div>
            </Card>
          </div>
        </div>
        
        <div class="contact-form-placeholder">
          <Card>
            <h3>Send a Message</h3>
            <p class="form-note">Contact form functionality is coming soon.</p>
            
            <form class="dummy-form" onsubmit="return false;">
              <div class="form-group">
                <label for="name">Name</label>
                <input type="text" id="name" disabled placeholder="Your Name" />
              </div>
              <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" disabled placeholder="your.email@example.com" />
              </div>
              <div class="form-group">
                <label for="message">Message</label>
                <textarea id="message" rows="4" disabled placeholder="How can we help you?"></textarea>
              </div>
              <Button text="Send Message" variant="primary" class="w-full" disabled />
            </form>
          </Card>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    text-align: center;
    padding: var(--space-16) 0;
  }
  
  .page-hero h1 {
    font-size: 2.5rem;
    margin-bottom: var(--space-4);
  }
  
  .lead {
    font-size: 1.25rem;
    color: var(--color-text-light);
    max-width: 600px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .page-hero h1 {
      font-size: 3.5rem;
    }
  }
  
  .contact-container {
    max-width: 1000px;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }

  @media (min-width: 768px) {
    .grid-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contact-desc {
    font-size: 1.125rem;
    color: var(--color-text-light);
    margin-bottom: var(--space-8);
  }

  .info-blocks {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .info-card h3 {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
  }
  
  .info-card a {
    color: var(--color-primary);
  }
  
  .social-links {
    display: flex;
    gap: var(--space-4);
  }
  
  .form-note {
    color: var(--color-text-light);
    font-size: 0.875rem;
    margin-bottom: var(--space-6);
  }

  .dummy-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    opacity: 0.7;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  
  label {
    font-weight: 500;
    font-size: 0.875rem;
  }

  input, textarea {
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-bg);
  }
  
  .w-full {
    width: 100%;
  }
</style>
