---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { verifyAdminSession } from '../../services/auth/admin';
import { db } from '../../db';
import { applications, members } from '../../db/schema';
import { eq, sql } from 'drizzle-orm';

const token = Astro.cookies.get('admin_session')?.value;
let admin = null;
if (token) {
  admin = await verifyAdminSession(token);
}
if (!admin) {
  return Astro.redirect('/admin/login');
}

// Fetch stats
const pendingCount = db.select({ count: sql<number>`count(*)` }).from(applications).where(eq(applications.status, 'PENDING_REVIEW')).get()?.count || 0;
const approvedCount = db.select({ count: sql<number>`count(*)` }).from(applications).where(eq(applications.status, 'APPROVED')).get()?.count || 0;
const rejectedCount = db.select({ count: sql<number>`count(*)` }).from(applications).where(eq(applications.status, 'REJECTED')).get()?.count || 0;
const activeMembersCount = db.select({ count: sql<number>`count(*)` }).from(members).where(eq(members.status, 'ACTIVE')).get()?.count || 0;
---

<AdminLayout title="Dashboard">
  <div class="dashboard-header">
    <h1>Dashboard</h1>
    <p>Welcome back, {admin.email}</p>
  </div>

  <div class="stats-grid">
    <div class="stat-card">
      <h3>Pending Applications</h3>
      <div class="stat-value">{pendingCount}</div>
      <a href="/admin/applications?status=PENDING_REVIEW" class="stat-link">View Pending</a>
    </div>
    <div class="stat-card">
      <h3>Approved Applications</h3>
      <div class="stat-value">{approvedCount}</div>
      <a href="/admin/applications?status=APPROVED" class="stat-link">View Approved</a>
    </div>
    <div class="stat-card">
      <h3>Rejected Applications</h3>
      <div class="stat-value">{rejectedCount}</div>
      <a href="/admin/applications?status=REJECTED" class="stat-link">View Rejected</a>
    </div>
    <div class="stat-card">
      <h3>Active Members</h3>
      <div class="stat-value">{activeMembersCount}</div>
      <a href="/admin/members" class="stat-link">View Members</a>
    </div>
  </div>
</AdminLayout>

<style>
  .dashboard-header {
    margin-bottom: var(--space-8);
  }
  .dashboard-header h1 {
    margin-bottom: var(--space-2);
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-6);
  }
  .stat-card {
    background: var(--color-bg-alt);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
  }
  .stat-card h3 {
    font-size: 1rem;
    color: var(--color-text-light);
    margin-bottom: var(--space-4);
  }
  .stat-value {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-secondary);
    margin-bottom: var(--space-4);
  }
  .stat-link {
    margin-top: auto;
    font-size: 0.875rem;
    color: var(--color-primary);
    text-decoration: underline;
  }
</style>
