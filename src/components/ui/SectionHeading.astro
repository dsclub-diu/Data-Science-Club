---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { title, subtitle, align = 'center' } = Astro.props;
---

<div class={`section-heading align-${align}`}>
  <h2>{title}</h2>
  {subtitle && <p class="subtitle">{subtitle}</p>}
</div>

<style>
  .section-heading {
    margin-bottom: var(--space-12);
  }
  
  .align-center {
    text-align: center;
  }
  
  .align-left {
    text-align: left;
  }

  h2 {
    font-size: 2rem;
    margin-bottom: var(--space-4);
  }

  @media (min-width: 768px) {
    h2 {
      font-size: 2.5rem;
    }
  }

  .subtitle {
    font-size: 1.125rem;
    color: var(--color-text-light);
    max-width: 600px;
  }
  
  .align-center .subtitle {
    margin-left: auto;
    margin-right: auto;
  }
</style>
